# =====================================================================
# SciPulse — variables d'environnement
# Copier ce fichier en .env (fait automatiquement par `make up`).
# Aucun secret réel n'est versionné : .env est dans .gitignore.
# =====================================================================

# --- Airflow ----------------------------------------------------------
# UID de l'utilisateur hôte (évite les problèmes de droits sur les volumes)
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=scipulse-dev-secret

# --- MinIO (data lake S3) --------------------------------------------
MINIO_ROOT_USER=scipulse
MINIO_ROOT_PASSWORD=scipulse-secret

# --- Stack Elastic ----------------------------------------------------
ELASTIC_VERSION=8.19.0
ES_HEAP=1g

# --- Sources de données ----------------------------------------------
# Kaggle : facultatif (le dataset ArXiv est public). Renseigner en cas de 401/403.
KAGGLE_USERNAME=
KAGGLE_KEY=
# OpenAlex : clé gratuite recommandée (budget x10) -> https://openalex.org/settings/api
OPENALEX_API_KEY=
OPENALEX_MAILTO=

# --- Périmètre du corpus (voir docs/01_ingestion.md) ------------------
# Catégories ArXiv primaires retenues en Silver
ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL,cs.CV,cs.IR,stat.ML
# Année minimale de première soumission
ARXIV_MIN_YEAR=2020
# Échantillon aléatoire déterministe (hash de l'id) en % — 100 = tout le périmètre.
# Les articles cités sur Hacker News sont toujours conservés (flag in_random_sample).
ARXIV_SAMPLE_PCT=25
# Nombre max d'articles envoyés à OpenAlex par exécution (budget API)
OPENALEX_MAX_IDS=40000
# Nombre max de pages Algolia (1000 stories/page) pour le backfill HN
HN_BACKFILL_MAX_PAGES=60

# --- Spark ------------------------------------------------------------
SPARK_WORKER_MEMORY=2560m
SPARK_EXECUTOR_MEMORY=1600m
SPARK_DRIVER_MEMORY=1g
# Extension C (KMeans + PCA) : true/false
ENABLE_CLUSTERING=true
